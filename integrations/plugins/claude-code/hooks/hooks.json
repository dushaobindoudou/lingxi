{
  "description": "Deterministic lifecycle -> 灵犀. These fire whether or not the model invokes the skill, which is the entire reason the plugin exists: a skill is advisory and most sessions never call one. They can only report WHAT happened, never how it felt - that needs something that has read the work, which is what the skill adds on top.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/../../adapters/lingxi-emit.mjs\" --host claude", "timeout": 3 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/../../adapters/lingxi-emit.mjs\" --host claude", "timeout": 3 }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/../../adapters/lingxi-emit.mjs\" --host claude", "timeout": 3 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/../../adapters/lingxi-emit.mjs\" --host claude", "timeout": 3 }
        ]
      }
    ]
  }
}
