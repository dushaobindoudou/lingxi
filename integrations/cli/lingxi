#!/usr/bin/env bash
# lingxi - drive the 灵犀 desktop cat from a shell.
#
# WHY THIS EXISTS ALONGSIDE THE MCP SERVER
#
# An MCP tool call is a separate approval surface: many hosts prompt for each tool, and an agent
# that wants to change the cat's face three times in a turn pays that cost three times. A shell
# script is one command. So this is the low-friction path - a skill can ship it, call it from
# Bash, and never register an MCP server at all. The MCP server remains the right choice when the
# host wants typed schemas and per-tool control.
#
# Everything below is a thin wrapper over the local HTTP bridge. The auth token is read from the
# file the app writes on first run, so there is nothing to configure.
#
# Usage:
#   lingxi health                              # is it running, where is the token
#   lingxi capabilities                        # every action / expression / theme, with source
#   lingxi state                               # position, state, expression, heading, intent
#   lingxi status                              # theme, camera, size, visibility
#   lingxi integration                         # the full contract, machine-readable
#
#   lingxi register <id> --logo <file.svg> [--name N] [--color #rrggbb]
#       Your logo is a mark you GENERATE for yourself - a small flat SVG, two or three colours,
#       no text, readable at 22px. It appears on the cat's speech bubble when it speaks for you.
#   lingxi task <state> [kind] [mood] [summary]   # the PREFERRED way to drive the cat
#       state: queued running blocked needs_input needs_approval completed failed cancelled
#       kind:  build test deploy review search write chat other
#       mood:  focused proud tender sad frustrated anxious weary playful curious
#       mood is what makes it a pet instead of a status light - you have the content,
#       so you are the only thing that can judge it. The cat ANSWERS the mood
#       (failure gets comfort, not alarm), it does not mirror it.
#
#   lingxi say <text>
#   lingxi express <expression> [action]
#   lingxi do <action>
#   lingxi perform <id>
#   lingxi toy <yarn|feather|laser|none>
#   lingxi look [--camera X] [--skin Y]
#
#   lingxi remember <text> [kind]
#   lingxi recall
#   lingxi remind <minutes> <text> [--mood M] [--every <minutes>]
#
#   lingxi assets                              # what custom assets are loaded, and any errors
#   lingxi reload                              # re-read the assets folder, then report
#   lingxi agents                              # who is driving
#   lingxi events                              # task event history
#   lingxi raw <METHOD> <PATH> [json]          # anything not covered above
#
# Environment:
#   LINGXI_PORT        default 47811
#   LINGXI_TOKEN       overrides the token file
#   LINGXI_TOKEN_FILE  overrides where the token is read from
#   LINGXI_AGENT       default `agent` value sent with control calls
#
# Identity otherwise comes from ~/.lingxi/agent.json - see `agent_id` below.
set -euo pipefail

PORT="${LINGXI_PORT:-47811}"
BASE="http://127.0.0.1:${PORT}"
# The bridge is loopback-only by construction, so no request this script makes should ever be
# handed to a proxy - but curl reads http_proxy/all_proxy from the environment and does exactly
# that, with no exemption for 127.0.0.1. On a machine with a local proxy exported (a Clash-style
# listener on 7890 is the common shape) every call below is silently relayed through it: whether
# that works at all depends on the proxy's own rules, the failure is a 502 or a hang rather than
# anything mentioning a proxy, and the bearer token goes to a third process on the way. NO_PROXY
# is not enough on its own - curl honours it, but the spelling and the wildcard handling vary by
# build - so the flag is set explicitly on every call via this variable.
NOPROXY=(--noproxy '*')
TOKEN_FILE="${LINGXI_TOKEN_FILE:-$HOME/Library/Application Support/com.dushaobin.lingxi-desktop/bridge-token}"

die() { printf '%s\n' "$*" >&2; exit 1; }

token() {
  if [ -n "${LINGXI_TOKEN:-}" ]; then printf '%s' "$LINGXI_TOKEN"; return; fi
  [ -r "$TOKEN_FILE" ] || die "No token. 灵犀 writes one to:
  $TOKEN_FILE
Start the app once to create it, or set LINGXI_TOKEN. \`lingxi health\` works without a token and
will tell you where the app thinks the file is."
  tr -d '[:space:]' < "$TOKEN_FILE"
}

# The id this machine speaks as - shared with the MCP server, so a machine driving both the
# script path and the MCP path attributes to ONE agent instead of looking like two.
#
# Read from ~/.lingxi/agent.json when the shell environment carries no LINGXI_AGENT. Why the file
# and not just the variable: some MCP hosts gate third-party servers behind an approval keyed by a
# hash of the server config, env KEY NAMES included. A host-local `env` block therefore breaks its
# own approval the moment a key is added or renamed, and the server stops being launched at all.
# Keeping identity in one machine-level file means no host config needs an `env` block. The full
# story is in the header comment of packages/mcp-server/src/bridge.mjs.
#
#   { "id": "workbuddy", "name": "WorkBuddy", "badge": "🐧", "color": "#0AC89F" }
#
# `name`/`badge`/`color` are used by the MCP server; the CLI only needs `id`.
AGENT_FILE="$HOME/.lingxi/agent.json"

agent_id() {
  if [ -n "${LINGXI_AGENT:-}" ]; then printf '%s' "$LINGXI_AGENT"; return; fi
  [ -r "$AGENT_FILE" ] || return 0
  # jq first, but NOT only jq: it is not preinstalled on macOS, and silently reporting no
  # identity on a machine without it is how the file and the tool disagree. python3 is
  # already required by json_typed below, so it is always a viable fallback here.
  if command -v jq >/dev/null 2>&1; then
    jq -r 'if type == "object" then (.id // empty) else empty end' "$AGENT_FILE" 2>/dev/null || true
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c '
import json, sys
try:
    with open(sys.argv[1]) as f:
        data = json.load(f)
except Exception:
    sys.exit(0)
if isinstance(data, dict):
    value = data.get("id")
    if isinstance(value, str):
        print(value)
' "$AGENT_FILE" 2>/dev/null || true
  fi
}

# request METHOD PATH [json-body]
request() {
  local method="$1" path="$2" body="${3:-}" code out hdr
  out=$(mktemp); hdr=$(mktemp)
  trap 'rm -f "$out" "$hdr"' RETURN
  # The token goes to curl through a config FILE, not the argv. `-H "Authorization: ..."` put
  # the bearer token in the process list for the whole request duration - `ps` shows every
  # local user's argv - which is exactly the leak the Rust-side hook command was fixed for.
  # Same fix, same reason.
  printf 'header = "Authorization: Bearer %s"\n' "$(token)" > "$hdr"
  if [ -n "$body" ]; then
    code=$(curl -s "${NOPROXY[@]}" -K "$hdr" -o "$out" -w '%{http_code}' --max-time 5 -X "$method" "$BASE$path" \
      -H 'Content-Type: application/json' -d "$body") || true
  else
    code=$(curl -s "${NOPROXY[@]}" -K "$hdr" -o "$out" -w '%{http_code}' --max-time 5 -X "$method" "$BASE$path") || true
  fi
  if [ -z "$code" ] || [ "$code" = "000" ]; then
    die "灵犀 is not reachable on $BASE. Is the app running? It listens only on localhost."
  fi
  # Pretty-print if something is around to do it; otherwise pass the JSON through untouched.
  # Purely cosmetic, so every branch here is optional - never a reason to fail.
  if command -v jq >/dev/null 2>&1; then
    jq . < "$out"
  elif command -v python3 >/dev/null 2>&1; then
    python3 -m json.tool < "$out" 2>/dev/null || { cat "$out"; echo; }
  else
    cat "$out"; echo
  fi
  # Non-2xx is a real failure and must be visible to the caller's `set -e`, not just readable.
  case "$code" in 2*) return 0;; *) return 1;; esac
}

# Build a JSON object from key=value pairs, with `agent` folded in. Values are passed through
# jq --arg so quotes, newlines and Chinese text cannot break the encoding - which is exactly the
# class of bug a hand-rolled printf would have.
json() { json_typed "$@"; }

# Build a JSON object from key=value pairs, folding in `agent` from the environment.
#
# Encoded by python3 or node rather than by hand. The text here is Chinese as often as not and
# routinely contains quotes and newlines, and a printf-built body produces invalid JSON the moment
# it does - which is a bug that shows up as a mystifying 400 rather than as anything obvious.
#
# It used to use jq, which was the wrong dependency: jq is NOT preinstalled on macOS, so the whole
# skill path died on a machine that had never had it, while python3 and node are both already
# there on any machine that can run this project. A `number:` prefix emits a JSON number.
json_typed() {
  local pairs=()
  local pair key value
  for pair in "$@"; do
    key="${pair%%=*}"
    value="${pair#*=}"
    [ -n "$value" ] || continue
    pairs+=("$key" "$value")
  done
  if [ -n "${LINGXI_AGENT:-}" ]; then pairs+=("agent" "$LINGXI_AGENT"); fi
  if [ ${#pairs[@]} -eq 0 ]; then printf '{}'; return; fi

  if command -v python3 >/dev/null 2>&1; then
    python3 -c '
import json, sys
argv = sys.argv[1:]
out = {}
for key, value in zip(argv[0::2], argv[1::2]):
    if value.startswith("number:"):
        raw = value[7:]
        try:
            out[key] = float(raw) if ("." in raw or "e" in raw.lower()) else int(raw)
        except ValueError:
            # A number that cannot be parsed is passed through AS A STRING rather than
            # dropped: the key vanishing silently turned a bad value into a confusing
            # "required field missing" error on the server, while the string survives to
            # produce a clear type error at the field that actually has the problem.
            out[key] = raw
    else:
        out[key] = value
sys.stdout.write(json.dumps(out, ensure_ascii=False))
' "${pairs[@]}"
  elif command -v node >/dev/null 2>&1; then
    node -e '
const argv = process.argv.slice(1);
const out = {};
for (let i = 0; i < argv.length; i += 2) {
  const key = argv[i];
  const value = argv[i + 1];
  if (value.startsWith("number:")) {
    const n = Number(value.slice(7));
    // Unparseable stays a string, for the same reason as the python path above: dropping the
    // key makes the failure surface as a missing-field error one layer away from the cause.
    if (Number.isFinite(n)) out[key] = n; else out[key] = value.slice(7);
  } else out[key] = value;
}
process.stdout.write(JSON.stringify(out));
' "${pairs[@]}"
  else
    die "need python3 or node to build a request body safely (neither found)"
  fi
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  health)
    # Deliberately unauthenticated - this is how you find out where the token lives.
    # A dead app used to exit 0 with NO OUTPUT (curl's empty body piped through the
    # pretty-printer), which scripts read as "healthy". Silence is failure here.
    health_out=$(curl -s "${NOPROXY[@]}" --max-time 5 "$BASE/health") || true
    [ -n "$health_out" ] || die "灵犀 is not reachable on $BASE. Is the app running? It listens only on localhost."
    printf '%s\n' "$health_out" | { command -v python3 >/dev/null 2>&1 && python3 -m json.tool 2>/dev/null || cat; } ;;
  capabilities|caps) request GET /capabilities ;;
  state)             request GET /perception ;;
  status)            request GET /status ;;
  integration)       request GET /integration ;;
  agents)            request GET /agents ;;
  activity)          request GET /activity ;;
  events)            request GET /debug/events ;;
  assets)            request GET /assets/status ;;
  recall)            request GET /memory ;;

  register)
    [ $# -ge 1 ] || die "usage: lingxi register <id> --logo <file.svg> [--name N] [--color #rrggbb]"
    reg_id="$1"; shift
    reg_logo=""; reg_name="$reg_id"; reg_color=""; reg_badge=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --logo)  [ -r "${2:-}" ] || die "cannot read logo file: ${2:-<missing>}"
                 reg_logo=$(cat "$2"); shift 2 ;;
        --name)  reg_name="${2:-}"; shift 2 ;;
        --color) reg_color="${2:-}"; shift 2 ;;
        --badge) reg_badge="${2:-}"; shift 2 ;;
        *) die "unknown option: $1" ;;
      esac
    done
    request POST /agents "$(json id="$reg_id" name="$reg_name" color="$reg_color" badge="$reg_badge" logo="$reg_logo")" ;;

  task)
    [ $# -ge 1 ] || die "usage: lingxi task <state> [kind] [mood] [summary]   (lingxi help for the vocabularies)"
    task_provider="$(agent_id)"; [ -n "$task_provider" ] || task_provider="cli"
    request POST /task-event \
      "$(json state="$1" kind="${2:-other}" mood="${3:-focused}" summary="${4:-}" \
              provider="$task_provider" taskId="${LINGXI_TASK_ID:-cli-$$}")" ;;

  say)     [ $# -ge 1 ] || die "usage: lingxi say <text>"; request POST /control "$(json say="$*")" ;;
  do)      [ $# -ge 1 ] || die "usage: lingxi do <action>"; request POST /control "$(json action="$1" priority="${LINGXI_PRIORITY:-status}")" ;;
  express) [ $# -ge 1 ] || die "usage: lingxi express <expression> [action]"
           request POST /control "$(json expression="$1" action="${2:-}" priority="${LINGXI_PRIORITY:-status}")" ;;
  perform) [ $# -ge 1 ] || die "usage: lingxi perform <id>"; request POST /control "$(json perform="$1" priority="${LINGXI_PRIORITY:-report}")" ;;
  toy)     [ $# -ge 1 ] || die "usage: lingxi toy <yarn|feather|laser|none>"; request POST /control "$(json toy="$1")" ;;

  look)
    camera=""; skin=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --camera) camera="${2:-}"; shift 2 ;;
        --skin)   skin="${2:-}"; shift 2 ;;
        *) die "usage: lingxi look [--camera X] [--skin Y]" ;;
      esac
    done
    [ -n "$camera$skin" ] || die "usage: lingxi look [--camera X] [--skin Y]"
    request POST /control "$(json camera="$camera" skin="$skin")" ;;

  remember) [ $# -ge 1 ] || die "usage: lingxi remember <text> [owner|project|preference|moment]"
            request POST /memory "$(json text="$1" kind="${2:-moment}")" ;;
  remind)   [ $# -ge 2 ] || die "usage: lingxi remind <minutes> <text> [--mood M] [--every <minutes>]   (mood is an option, not positional - the text may be any number of words)"
            minutes="$1"; shift
            rem_every=0; rem_mood=""
            rem_args=()
            while [ $# -gt 0 ]; do
              case "$1" in
                --every) rem_every="${2:-0}"; shift 2 ;;
                --mood)  rem_mood="${2:-}"; shift 2 ;;
                *) rem_args+=("$1"); shift ;;
              esac
            done
            request POST /reminders "$(json_typed inMinutes="number:$minutes" text="${rem_args[*]}" \
              mood="$rem_mood" repeatEveryMinutes="number:$rem_every")" ;;

  unremind)
    [ $# -ge 1 ] || die "usage: lingxi unremind <id>   (lingxi raw GET /reminders lists them)"
    request DELETE "/reminders/$1" ;;

  reload)
    request POST /control '{"reloadAssets":true}' >/dev/null
    sleep 1   # the reload is asynchronous; /assets/status is where the result lands
    request GET /assets/status ;;

  raw)
    [ $# -ge 2 ] || die "usage: lingxi raw <METHOD> <PATH> [json]"
    request "$1" "$2" "${3:-}" ;;

  help|-h|--help)
    sed -n '3,50p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)
    die "unknown command: $cmd  (try: lingxi help)" ;;
esac
