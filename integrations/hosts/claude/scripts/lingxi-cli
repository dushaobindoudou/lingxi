#!/usr/bin/env bash
# lingxi - drive the 灵犀 desktop cat from a shell.
#
# WHY THIS EXISTS ALONGSIDE THE MCP SERVER
#
# An MCP tool call is a separate approval surface: many hosts prompt for each tool, and an agent
# that wants to change the cat's face three times in a turn pays that cost three times. A shell
# script is one command. So this is the low-friction path - a skill can ship it, call it from
# Bash, and never register an MCP server at all. The MCP server remains the right choice when the
# host wants typed schemas and per-tool control.
#
# Everything below is a thin wrapper over the local HTTP bridge. The auth token is read from the
# file the app writes on first run, so there is nothing to configure.
#
# Usage:
#   lingxi up                                  # THE CHECK: running? if not, start it and wait
#   lingxi health                              # is it running, where is the token (never starts it)
#   lingxi capabilities                        # every action / expression / theme, with source
#   lingxi state                               # position, state, expression, heading, intent
#   lingxi status                              # theme, camera, size, visibility
#   lingxi integration                         # the full contract, machine-readable
#
#   lingxi register <id> --logo <file.svg> [--name N] [--color #rrggbb]
#       Your logo is a mark you GENERATE for yourself - a small flat SVG, two or three colours,
#       no text, readable at 22px. It appears on the cat's speech bubble when it speaks for you.
#   lingxi task <state> [kind] [mood] [summary]   # the PREFERRED way to drive the cat
#       state: queued running blocked needs_input needs_approval completed failed cancelled
#       kind:  build test deploy review search write chat other
#       mood:  focused proud tender sad frustrated anxious weary playful curious
#       mood is what makes it a pet instead of a status light - you have the content,
#       so you are the only thing that can judge it. The cat ANSWERS the mood
#       (failure gets comfort, not alarm), it does not mirror it.
#
#   lingxi say <text>
#   lingxi express <expression> [action]
#   lingxi do <action>
#   lingxi perform <id>
#   lingxi toy <yarn|feather|laser|none>
#   lingxi look [--camera X] [--skin Y]
#
#   lingxi remember <text> [kind]
#   lingxi recall
#   lingxi remind <minutes|HH:MM> <text> [--mood M] [--every <minutes>]
#   lingxi reminders                      # what is set, with ids for unremind
#
#   lingxi doctor                              # check every prerequisite, and say what to do
#   lingxi assets                              # what custom assets are loaded, and any errors
#   lingxi reload                              # re-read the assets folder, then report
#   lingxi agents                              # who is driving
#   lingxi events                              # task event history
#   lingxi raw <METHOD> <PATH> [json]          # anything not covered above
#
# Environment:
#   LINGXI_PORT        default 47811
#   LINGXI_TOKEN       overrides the token file
#   LINGXI_TOKEN_FILE  overrides where the token is read from
#   LINGXI_AGENT       default `agent` value sent with control calls
#   LINGXI_AUTOSTART   0 to never start the app for you (default: start it if it is not running)
#
# Identity otherwise comes from ~/.lingxi/agent.json - see `agent_id` below.
set -euo pipefail

PORT="${LINGXI_PORT:-47811}"
BASE="http://127.0.0.1:${PORT}"
# The bridge is loopback-only by construction, so no request this script makes should ever be
# handed to a proxy - but curl reads http_proxy/all_proxy from the environment and does exactly
# that, with no exemption for 127.0.0.1. On a machine with a local proxy exported (a Clash-style
# listener on 7890 is the common shape) every call below is silently relayed through it: whether
# that works at all depends on the proxy's own rules, the failure is a 502 or a hang rather than
# anything mentioning a proxy, and the bearer token goes to a third process on the way. NO_PROXY
# is not enough on its own - curl honours it, but the spelling and the wildcard handling vary by
# build - so the flag is set explicitly on every call via this variable.
NOPROXY=(--noproxy '*')
TOKEN_FILE="${LINGXI_TOKEN_FILE:-$HOME/Library/Application Support/com.dushaobin.lingxi-desktop/bridge-token}"

die() { printf '%s\n' "$*" >&2; exit 1; }

token() {
  if [ -n "${LINGXI_TOKEN:-}" ]; then printf '%s' "$LINGXI_TOKEN"; return; fi
  [ -r "$TOKEN_FILE" ] || die "No token. 灵犀 writes one to:
  $TOKEN_FILE
Start the app once to create it, or set LINGXI_TOKEN. \`lingxi health\` works without a token and
will tell you where the app thinks the file is."
  tr -d '[:space:]' < "$TOKEN_FILE"
}

# The id this machine speaks as - shared with the MCP server, so a machine driving both the
# script path and the MCP path attributes to ONE agent instead of looking like two.
#
# Read from ~/.lingxi/agent.json when the shell environment carries no LINGXI_AGENT. Why the file
# and not just the variable: some MCP hosts gate third-party servers behind an approval keyed by a
# hash of the server config, env KEY NAMES included. A host-local `env` block therefore breaks its
# own approval the moment a key is added or renamed, and the server stops being launched at all.
# Keeping identity in one machine-level file means no host config needs an `env` block. The full
# story is in the header comment of packages/mcp-server/src/bridge.mjs.
#
#   { "id": "workbuddy", "name": "WorkBuddy", "badge": "🐧", "color": "#0AC89F" }
#
# `name`/`badge`/`color` are used by the MCP server; the CLI only needs `id`.
AGENT_FILE="$HOME/.lingxi/agent.json"

agent_id() {
  if [ -n "${LINGXI_AGENT:-}" ]; then printf '%s' "$LINGXI_AGENT"; return; fi
  # Inside Claude Code (which marks its shells CLAUDECODE=1) this IS Claude, whatever the
  # machine-wide file says. That file is written by whichever host installed last - it once said
  # "workbuddy" and every line Claude had the cat say went out under WorkBuddy's penguin. The
  # hooks speak as "claude"; so does this.
  if [ "${CLAUDECODE:-}" = 1 ]; then printf 'claude'; return; fi
  # Codex marks the shells it runs the same way, with the thread they belong to.
  if [ -n "${CODEX_THREAD_ID:-}" ]; then printf 'codex'; return; fi
  [ -r "$AGENT_FILE" ] || return 0
  # jq first, but NOT only jq: it is not preinstalled on macOS, and silently reporting no
  # identity on a machine without it is how the file and the tool disagree. python3 is
  # already required by json_typed below, so it is always a viable fallback here.
  if command -v jq >/dev/null 2>&1; then
    jq -r 'if type == "object" then (.id // empty) else empty end' "$AGENT_FILE" 2>/dev/null || true
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c '
import json, sys
try:
    with open(sys.argv[1]) as f:
        data = json.load(f)
except Exception:
    sys.exit(0)
if isinstance(data, dict):
    value = data.get("id")
    if isinstance(value, str):
        print(value)
' "$AGENT_FILE" 2>/dev/null || true
  fi
}

# The host session this shell belongs to, sent with task reports so a task the model reports lands
# on the same 主界面 row as that session's hook events - and so the app can tell that the hook's
# turn-end which follows only repeats it. Claude Code and Codex put their session id in the
# environment of every shell they run; LINGXI_SESSION overrides for anything else.
agent_session() {
  if [ -n "${LINGXI_SESSION:-}" ]; then printf '%s' "$LINGXI_SESSION"; return; fi
  case "$(agent_id)" in
    claude) printf '%s' "${CLAUDE_CODE_SESSION_ID:-}" ;;
    codex)  printf '%s' "${CODEX_THREAD_ID:-}" ;;
  esac
}

# --- is the app there, and can we start it? -------------------------------------------------
#
# The bridge only exists while the app does, and until now the app was the one thing no
# integration could start: every path ended at "灵犀 is not reachable", which is true and
# useless when the caller is a model and the person who could open it is not watching.
#
# Opt out with LINGXI_AUTOSTART=0 - a command that makes a window appear on someone's desktop
# should be refusable. They may be presenting, or simply not want the cat right now.

BUNDLE_ID="com.dushaobin.lingxi-desktop"

bridge_is_up() {
  # /health needs no token, so this works before the token file exists.
  curl -s "${NOPROXY[@]}" --max-time 2 -o /dev/null "$BASE/health" 2>/dev/null
}

# Where the app is installed, or nothing. mdfind by bundle id first, because that is the same
# index `open -b` consults and it finds the app wherever the user actually put it.
app_path() {
  local found candidate
  for candidate in "/Applications/灵犀.app" "$HOME/Applications/灵犀.app" "/Applications/lingxi.app"; do
    [ -d "$candidate" ] && { printf '%s' "$candidate"; return 0; }
  done
  # Spotlight second, and never a build output, a mounted image or the Trash: starting the copy
  # in src-tauri/target/…/bundle instead of the installed app is exactly what it used to do.
  if command -v mdfind >/dev/null 2>&1; then
    found="$(mdfind "kMDItemCFBundleIdentifier == '$BUNDLE_ID'" 2>/dev/null \
      | grep -v -e '^/Volumes/' -e '/target/' -e '/\.Trash/' -e '/node_modules/' | sed -n 1p || true)"
    [ -n "$found" ] && { printf '%s' "$found"; return 0; }
  fi
  # Not found is an answer, not a failure: callers test the output, and a non-zero return here
  # would abort the whole script under `set -e` the moment the app is not installed - which is
  # precisely the case `doctor` exists to report on.
  return 0
}

# Start the app and wait for the bridge. Returns non-zero with a reason on stderr.
start_app() {
  case "${LINGXI_AUTOSTART:-1}" in
    0|false|no)
      printf '%s\n' "灵犀 is not running, and LINGXI_AUTOSTART=${LINGXI_AUTOSTART} asked me not to start it." >&2
      return 1 ;;
  esac
  [ "$(uname -s)" = "Darwin" ] || {
    printf '%s\n' "灵犀 is not running. This script only knows how to start it on macOS." >&2
    return 1
  }
  local path; path="$(app_path)"
  [ -n "$path" ] || {
    printf '%s\n' "灵犀 is not installed - nothing to start. Build it with \`npm run tauri build\` in apps/lingxi." >&2
    return 1
  }
  # -g: do not steal focus. The cat becomes visible on the desktop; the user keeps their window.
  # By path first: `open -b` lets Launch Services pick any copy it has registered, build outputs
  # included.
  open -g "$path" 2>/dev/null || open -g -b "$BUNDLE_ID" 2>/dev/null || {
    printf '%s\n' "could not start 灵犀 at $path" >&2
    return 1
  }
  printf '%s' "灵犀 was not running, starting it" >&2
  local waited=0
  while [ "$waited" -lt 150 ]; do   # 15s, in 0.1s steps
    if bridge_is_up; then printf '%s\n' " - up." >&2; return 0; fi
    sleep 0.1; waited=$((waited + 1))
    [ $((waited % 10)) -eq 0 ] && printf '.' >&2
  done
  printf '%s\n' "" >&2
  printf '%s\n' "灵犀 started but its bridge did not answer within 15s. Another process may hold port $PORT:
  lsof -nP -iTCP:$PORT -sTCP:LISTEN" >&2
  return 1
}

# Called before the first request of a run, and at most once more if the app dies mid-run.
# Capped because a start that did not take is not going to take on the fourth try either, and a
# script in a loop would otherwise spend a minute of timeouts per iteration.
AUTOSTART_TRIES=0
ensure_running() {
  [ "$AUTOSTART_TRIES" -ge 1 ] && return 0
  AUTOSTART_TRIES=1
  bridge_is_up && return 0
  start_app
}
ensure_running_again() {
  [ "$AUTOSTART_TRIES" -ge 2 ] && return 1
  AUTOSTART_TRIES=2
  bridge_is_up && return 0
  start_app
}

# request METHOD PATH [json-body]
request() {
  local method="$1" path="$2" body="${3:-}" code out hdr
  out=$(mktemp); hdr=$(mktemp)
  trap 'rm -f "$out" "$hdr"' RETURN

  # Start the app before anything needs the token: the token file is written by the app, so on a
  # machine where it has never run there is nothing to read and `token` would die here with a
  # message about a missing file rather than about a missing cat.
  ensure_running || true

  write_headers "$hdr"
  send_request "$method" "$path" "$body" "$hdr" "$out"; code="$REPLY_CODE"

  if [ -z "$code" ] || [ "$code" = "000" ]; then
    # Unreachable despite the check above - the app may have quit between the two. One more try,
    # with fresh headers: a restart mints a new token, so the old one would 401.
    if ensure_running_again; then
      write_headers "$hdr"
      send_request "$method" "$path" "$body" "$hdr" "$out"; code="$REPLY_CODE"
    fi
  fi
  if [ -z "$code" ] || [ "$code" = "000" ]; then
    die "灵犀 is not reachable on $BASE. Is the app running? It listens only on localhost."
  fi
  # Pretty-print if something is around to do it; otherwise pass the JSON through untouched.
  # Purely cosmetic, so every branch here is optional - never a reason to fail.
  if command -v jq >/dev/null 2>&1; then
    jq . < "$out"
  elif command -v python3 >/dev/null 2>&1; then
    python3 -m json.tool < "$out" 2>/dev/null || { cat "$out"; echo; }
  else
    cat "$out"; echo
  fi
  # Non-2xx is a real failure and must be visible to the caller's `set -e`, not just readable.
  case "$code" in 2*) return 0;; *) return 1;; esac
}

# The token goes to curl through a config FILE, not the argv. `-H "Authorization: ..."` put the
# bearer token in the process list for the whole request duration - `ps` shows every local
# user's argv - which is exactly the leak the Rust-side hook command was fixed for. Same fix,
# same reason. Rebuilt rather than reused after a restart, because a restart mints a new token.
write_headers() {
  local hdr="$1" ident
  printf 'header = "Authorization: Bearer %s"\n' "$(token)" > "$hdr"
  # Who is calling, on every request. `json()` already folds `agent` into the body, which is
  # what /control and /task-event read - but /memory and /reminders decide the permission tier
  # from this header, and a `lingxi remember` that travelled without it was filed under
  # `anonymous` and refused with a 403 that named an id the user had never seen.
  ident="$(agent_id)"
  [ -n "$ident" ] && printf 'header = "X-Lingxi-Agent: %s"\n' "$ident" >> "$hdr"
  return 0
}

# Sets REPLY_CODE. A separate function only so the retry above is the same call, not a copy.
send_request() {
  local method="$1" path="$2" body="$3" hdr="$4" out="$5"
  if [ -n "$body" ]; then
    REPLY_CODE=$(curl -s "${NOPROXY[@]}" -K "$hdr" -o "$out" -w '%{http_code}' --max-time 5 -X "$method" "$BASE$path" \
      -H 'Content-Type: application/json' -d "$body") || true
  else
    REPLY_CODE=$(curl -s "${NOPROXY[@]}" -K "$hdr" -o "$out" -w '%{http_code}' --max-time 5 -X "$method" "$BASE$path") || true
  fi
  return 0
}

# Build a JSON object from key=value pairs, with `agent` folded in. Values are passed through
# jq --arg so quotes, newlines and Chinese text cannot break the encoding - which is exactly the
# class of bug a hand-rolled printf would have.
json() { json_typed "$@"; }

# Build a JSON object from key=value pairs, folding in `agent` from the environment.
#
# Encoded by python3 or node rather than by hand. The text here is Chinese as often as not and
# routinely contains quotes and newlines, and a printf-built body produces invalid JSON the moment
# it does - which is a bug that shows up as a mystifying 400 rather than as anything obvious.
#
# It used to use jq, which was the wrong dependency: jq is NOT preinstalled on macOS, so the whole
# skill path died on a machine that had never had it, while python3 and node are both already
# there on any machine that can run this project. A `number:` prefix emits a JSON number.
json_typed() {
  local pairs=()
  local pair key value
  for pair in "$@"; do
    key="${pair%%=*}"
    value="${pair#*=}"
    [ -n "$value" ] || continue
    pairs+=("$key" "$value")
  done
  # Fold the machine identity into EVERY call, not just task events: a `lingxi say` used to
  # arrive with no agent at all, and the bridge filed it under "anonymous" - the user saw the
  # cat speak for nobody. The identity source is the same one agent_id() uses (env wins, then
  # ~/.lingxi/agent.json), so all paths attribute identically.
  local ident
  ident="$(agent_id)"
  if [ -n "$ident" ]; then pairs+=("agent" "$ident"); fi
  if [ ${#pairs[@]} -eq 0 ]; then printf '{}'; return; fi

  if command -v python3 >/dev/null 2>&1; then
    python3 -c '
import json, sys
argv = sys.argv[1:]
out = {}
for key, value in zip(argv[0::2], argv[1::2]):
    if value.startswith("number:"):
        raw = value[7:]
        try:
            out[key] = float(raw) if ("." in raw or "e" in raw.lower()) else int(raw)
        except ValueError:
            # A number that cannot be parsed is passed through AS A STRING rather than
            # dropped: the key vanishing silently turned a bad value into a confusing
            # "required field missing" error on the server, while the string survives to
            # produce a clear type error at the field that actually has the problem.
            out[key] = raw
    else:
        out[key] = value
sys.stdout.write(json.dumps(out, ensure_ascii=False))
' "${pairs[@]}"
  elif command -v node >/dev/null 2>&1; then
    node -e '
const argv = process.argv.slice(1);
const out = {};
for (let i = 0; i < argv.length; i += 2) {
  const key = argv[i];
  const value = argv[i + 1];
  if (value.startsWith("number:")) {
    const n = Number(value.slice(7));
    // Unparseable stays a string, for the same reason as the python path above: dropping the
    // key makes the failure surface as a missing-field error one layer away from the cause.
    if (Number.isFinite(n)) out[key] = n; else out[key] = value.slice(7);
  } else out[key] = value;
}
process.stdout.write(JSON.stringify(out));
' "${pairs[@]}"
  else
    die "need python3 or node to build a request body safely (neither found)"
  fi
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  doctor)
    # Every prerequisite, in the order they have to hold, each with what to do about it.
    #
    # This exists because the failures are indistinguishable from the outside. "The cat did not
    # react" is produced by: the app not running, the app running with a dead bridge, a token
    # this account cannot read, a permission tier that refuses writes, a skill that was never
    # installed, and a host whose plugin was never enabled. Six causes, one symptom, and the
    # error text a model sees names at most one of them.
    fail=0; warn=0
    ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
    bad()  { printf '  \033[31m✗\033[0m %s\n' "$*"; fail=$((fail+1)); }
    note() { printf '  \033[33m!\033[0m %s\n' "$*"; warn=$((warn+1)); }
    hint() { printf '      %s\n' "$*"; }

    printf '\n灵犀 doctor\n\n应用\n'
    app_at="$(app_path)"
    if [ -n "$app_at" ]; then ok "已安装  $app_at"
    else bad "找不到 .app"; hint "在 apps/lingxi 里跑 npm run tauri build，或把 .app 拖进 /Applications"; fi

    if bridge_is_up; then ok "桥接在跑  $BASE"
    else
      if [ -n "$app_at" ] && start_app 2>/dev/null; then ok "桥接没在跑，已启动  $BASE"
      else bad "桥接不通  $BASE"
         hint "端口被别的进程占着的话：lsof -nP -iTCP:$PORT -sTCP:LISTEN"; fi
    fi

    case "${LINGXI_AUTOSTART:-1}" in
      0|false|no) note "LINGXI_AUTOSTART=${LINGXI_AUTOSTART}：这个环境里的接入都不会替你启动猫"
                  hint "想让 CLI / MCP / hooks 在猫没开时拉起它，去掉这个变量" ;;
    esac

    printf '\n鉴权\n'
    if [ -n "${LINGXI_TOKEN:-}" ]; then note "token 来自 LINGXI_TOKEN 环境变量（会进 shell 历史）"
    elif [ -r "$TOKEN_FILE" ]; then
      perm="$(stat -f '%Lp' "$TOKEN_FILE" 2>/dev/null || echo '???')"
      if [ "$perm" = "600" ]; then ok "token 可读，权限 0600"
      else note "token 可读，但权限是 0${perm}（应该是 0600）"; hint "chmod 600 \"$TOKEN_FILE\""; fi
    else bad "读不到 token  $TOKEN_FILE"; hint "应用启动一次就会生成"; fi

    printf '\n署名\n'
    ident="$(agent_id)"
    if [ -n "$ident" ]; then
      ok "以「${ident}」的身份调用"
      [ -n "${LINGXI_AGENT:-}" ] && hint "来自 LINGXI_AGENT（优先于 ${AGENT_FILE}）" || hint "来自 $AGENT_FILE"
    else
      note "没有署名，调用会记成 anonymous"
      hint "写一份 ${AGENT_FILE}：{\"id\":\"你的-id\",\"name\":\"...\",\"badge\":\"🐧\"}"
    fi

    printf '\n权限\n'
    if bridge_is_up; then
      who="${ident:-anonymous}"
      tier="$(curl -s "${NOPROXY[@]}" --max-time 3 -H "Authorization: Bearer $(token 2>/dev/null)" "$BASE/agents" 2>/dev/null \
        | python3 -c '
import json,sys
try: data=json.load(sys.stdin)
except Exception: sys.exit(0)
rows = data.get("agents", data) if isinstance(data, dict) else data
if isinstance(rows, list):
    for row in rows:
        if isinstance(row, dict) and row.get("id") == sys.argv[1]:
            print(row.get("permission", "")); break
' "$who" 2>/dev/null || true)"
      case "$tier" in
        trusted)   ok "「${who}」是 trusted —— 表演、记忆、提醒、改设置都可以" ;;
        performer) ok "「${who}」是 performer（默认）—— 能表演，不能写记忆/提醒/设置"
                   hint "要 remember / remind：主界面 → Agent 接入 →「权限与日志」→ 改成 trusted" ;;
        observer)  note "「${who}」是 observer —— 只能读" ;;
        "")        note "「${who}」还没在注册表里出现过（注册表是内存的，重启即空）"
                   hint "调一次就会出现；档位按默认的 performer 处理" ;;
        *)         note "「${who}」的档位是 $tier" ;;
      esac
    else note "桥接不通，跳过档位检查"; fi

    printf '\n技能与宿主\n'
    # Two layers per host (integrations/hosts/PLUGIN-STANDARD.md, 六): the shared lingxi skill and
    # the host's own lingxi-<id>. The system layer alone leaves the model guessing its identity.
    for entry in "Claude Code|$HOME/.claude/skills|claude" "Codex|$HOME/.codex/skills|codex" \
                 "WorkBuddy|$HOME/.workbuddy/skills|workbuddy" "Cursor|$HOME/.cursor/skills|cursor"; do
      host="${entry%%|*}"; rest="${entry#*|}"; dir="${rest%%|*}"; id="${rest#*|}"
      if [ -e "$dir/lingxi" ] && [ -e "$dir/lingxi-$id" ]; then ok "${host}  skill 已装（lingxi + lingxi-${id}）"
      elif [ -e "$dir/lingxi" ]; then note "${host}  只有系统层 lingxi，缺宿主层 lingxi-${id}"
                                      hint "重跑这个宿主的安装器，或 integrations/install-skills.sh"
      else printf '  \033[90m·\033[0m %s  skill 未装（integrations/install-skills.sh）\n' "$host"; fi
    done
    if grep -q '"lingxi@' "$HOME/.claude/plugins/installed_plugins.json" 2>/dev/null; then
      ok "Claude Code  插件 lingxi 已装（会话开始时自动检查、安装、打开灵犀；/lingxi:status 看详情）"
      grep -q '127.0.0.1:47811/task-event' "$HOME/.claude/settings.json" 2>/dev/null \
        && hint "另外还有「一键接入」的 hooks——插件会自动让路，不会重复"
    elif grep -q 'open -g -b com.dushaobin.lingxi-desktop' "$HOME/.claude/settings.json" 2>/dev/null; then
      ok "Claude Code  hooks 已装，会话开始时猫没开会自动拉起"
    elif grep -q '47811/task-event' "$HOME/.claude/settings.json" 2>/dev/null; then
      note "Claude Code  hooks 是旧版：能报事件，但会话开始时不会把没开的猫拉起来"
      hint "新版应用启动一次就会原地升级；或主界面 → Agent 接入 → 一键接入 再点一次"
    else printf '  \033[90m·\033[0m %s\n' "Claude Code  hooks 未装（主界面 → Agent 接入 → 一键接入）"; fi
    if grep -qE '^[[:space:]]*notify[[:space:]]*=.*(lingxi|fanout)' "$HOME/.codex/config.toml" 2>/dev/null; then ok "Codex  notify 已装"
    else printf '  \033[90m·\033[0m %s\n' "Codex  notify 未装（integrations/hosts/codex/install.sh）"; fi

    printf '\n'
    if [ "$fail" -gt 0 ]; then printf '%s\n\n' "$fail 项不通过，$warn 项需要注意。"; exit 1
    elif [ "$warn" -gt 0 ]; then printf '%s\n\n' "都能用，$warn 项需要注意。"
    else printf '%s\n\n' "全部通过。"; fi ;;

  up|start|ensure)
    # The check module as one command, for anything that wants the cat up before it starts -
    # a skill's first step, a hook, an install script. Idempotent: a running app is left alone,
    # a closed one is started without taking focus, and the answer is in the exit code. Every
    # other subcommand already does this on its own; this is for when nothing else needs doing.
    if bridge_is_up; then printf '%s\n' "灵犀 is running on $BASE"; exit 0; fi
    start_app || exit 1
    printf '%s\n' "灵犀 is running on $BASE (started just now)" ;;

  health)
    # Deliberately unauthenticated - this is how you find out where the token lives.
    # A dead app used to exit 0 with NO OUTPUT (curl's empty body piped through the
    # pretty-printer), which scripts read as "healthy". Silence is failure here.
    health_out=$(curl -s "${NOPROXY[@]}" --max-time 5 "$BASE/health") || true
    [ -n "$health_out" ] || die "灵犀 is not reachable on $BASE. Is the app running? It listens only on localhost."
    printf '%s\n' "$health_out" | { command -v python3 >/dev/null 2>&1 && python3 -m json.tool 2>/dev/null || cat; } ;;
  capabilities|caps) request GET /capabilities ;;
  state)             request GET /perception ;;
  status)            request GET /status ;;
  integration)       request GET /integration ;;
  agents)            request GET /agents ;;
  activity)          request GET /activity ;;
  events)            request GET /debug/events ;;
  assets)            request GET /assets/status ;;
  recall)            request GET /memory ;;

  register)
    [ $# -ge 1 ] || die "usage: lingxi register <id> --logo <file.svg> [--name N] [--color #rrggbb]"
    reg_id="$1"; shift
    reg_logo=""; reg_name="$reg_id"; reg_color=""; reg_badge=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --logo)  [ -r "${2:-}" ] || die "cannot read logo file: ${2:-<missing>}"
                 reg_logo=$(cat "$2"); shift 2 ;;
        --name)  reg_name="${2:-}"; shift 2 ;;
        --color) reg_color="${2:-}"; shift 2 ;;
        --badge) reg_badge="${2:-}"; shift 2 ;;
        *) die "unknown option: $1" ;;
      esac
    done
    request POST /agents "$(json id="$reg_id" name="$reg_name" color="$reg_color" badge="$reg_badge" logo="$reg_logo")" ;;

  task)
    [ $# -ge 1 ] || die "usage: lingxi task <state> [kind] [mood] [summary]   (lingxi help for the vocabularies)"
    task_provider="$(agent_id)"; [ -n "$task_provider" ] || task_provider="cli"
    request POST /task-event \
      "$(json state="$1" kind="${2:-other}" mood="${3:-focused}" summary="${4:-}" \
              provider="$task_provider" taskId="${LINGXI_TASK_ID:-cli-$$}" session="$(agent_session)")" ;;

  say)     [ $# -ge 1 ] || die "usage: lingxi say <text>"; request POST /control "$(json say="$*")" ;;
  do)      [ $# -ge 1 ] || die "usage: lingxi do <action>"; request POST /control "$(json action="$1" priority="${LINGXI_PRIORITY:-status}")" ;;
  express) [ $# -ge 1 ] || die "usage: lingxi express <expression> [action]"
           request POST /control "$(json expression="$1" action="${2:-}" priority="${LINGXI_PRIORITY:-status}")" ;;
  perform) [ $# -ge 1 ] || die "usage: lingxi perform <id>"; request POST /control "$(json perform="$1" priority="${LINGXI_PRIORITY:-report}")" ;;
  toy)     [ $# -ge 1 ] || die "usage: lingxi toy <yarn|feather|laser|none>"; request POST /control "$(json toy="$1")" ;;

  look)
    camera=""; skin=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --camera) camera="${2:-}"; shift 2 ;;
        --skin)   skin="${2:-}"; shift 2 ;;
        *) die "usage: lingxi look [--camera X] [--skin Y]" ;;
      esac
    done
    [ -n "$camera$skin" ] || die "usage: lingxi look [--camera X] [--skin Y]"
    request POST /control "$(json camera="$camera" skin="$skin")" ;;

  remember) [ $# -ge 1 ] || die "usage: lingxi remember <text> [owner|project|preference|moment]"
            request POST /memory "$(json text="$1" kind="${2:-moment}")" ;;
  remind)   [ $# -ge 2 ] || die "usage: lingxi remind <minutes|HH:MM> <text> [--mood M] [--every <minutes>]   (mood is an option, not positional - the text may be any number of words)"
            minutes="$1"; shift
            # A clock time - "09:30" - is the next time the clock reads that, today or tomorrow.
            # With --every 1440 it is a daily reminder that stays at 09:30 (the app keeps it on
            # its own schedule).
            when_field="inMinutes=number:$minutes"
            case "$minutes" in
              [0-9]:[0-5][0-9]|[01][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9])
                at=$(date -j -f "%Y-%m-%d %H:%M:%S" "$(date +%Y-%m-%d) $minutes:00" +%s 2>/dev/null) \
                  || die "cannot read the time $minutes"
                [ "$at" -gt "$(date +%s)" ] || at=$((at + 86400))
                when_field="dueAt=number:${at}000" ;;
              *[!0-9]*|'') die "lingxi remind: \"$minutes\" is neither minutes nor HH:MM" ;;
            esac
            rem_every=0; rem_mood=""
            rem_args=()
            while [ $# -gt 0 ]; do
              case "$1" in
                --every) rem_every="${2:-0}"; shift 2 ;;
                --mood)  rem_mood="${2:-}"; shift 2 ;;
                *) rem_args+=("$1"); shift ;;
              esac
            done
            request POST /reminders "$(json_typed "$when_field" text="${rem_args[*]}" \
              mood="$rem_mood" repeatEveryMinutes="number:$rem_every")" ;;

  reminders) request GET /reminders ;;

  unremind)
    [ $# -ge 1 ] || die "usage: lingxi unremind <id>   (lingxi raw GET /reminders lists them)"
    request DELETE "/reminders/$1" ;;

  reload)
    request POST /control '{"reloadAssets":true}' >/dev/null
    sleep 1   # the reload is asynchronous; /assets/status is where the result lands
    request GET /assets/status ;;

  raw)
    [ $# -ge 2 ] || die "usage: lingxi raw <METHOD> <PATH> [json]"
    request "$1" "$2" "${3:-}" ;;

  help|-h|--help)
    sed -n '3,50p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)
    die "unknown command: $cmd  (try: lingxi help)" ;;
esac
