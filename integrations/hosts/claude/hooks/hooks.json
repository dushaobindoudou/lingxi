{
  "description": "灵犀桌面猫的生命周期 hooks。SessionStart 是检查模块：没装就后台安装、没开就后台打开、再补发这条事件，毫秒级返回，不拖住会话。其余事件只投递、异步执行，猫没开就什么都不做。与主界面「一键接入」写进 settings.json 的 hooks 共存时自动让路，不会重复。",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\"", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/event.sh\"", "timeout": 10, "async": true }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/event.sh\"", "timeout": 10, "async": true }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/event.sh\"", "timeout": 10, "async": true }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/event.sh\"", "timeout": 10, "async": true }
        ]
      }
    ]
  }
}
