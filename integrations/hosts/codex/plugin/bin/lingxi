#!/usr/bin/env bash
# `lingxi` for Codex - the same client the app ships (scripts/lingxi-cli is a byte-for-byte copy
# of integrations/cli/lingxi, held there by a test) that always speaks as Codex, whatever
# ~/.lingxi/agent.json says: on a machine that also runs WorkBuddy or Claude that file names one
# of them, and calls from this session would be credited to the wrong agent.
export LINGXI_AGENT="${LINGXI_CODEX_AGENT:-codex}"
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/scripts/lingxi-cli" "$@"
